# 🍍 Ananas — safe environment template
# Copy locally to .env only when needed. Never commit real values.

NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
ANANAS_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b
ANANAS_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional Google Cloud deployment settings
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=
